{
  "name": "entity-viewer",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "vocab": "tsx scripts/build-vocab.ts",
    "predev": "npm run vocab",
    "dev": "vite build --watch",
    "predev:chrome": "npm run vocab",
    "dev:chrome": "TARGET=chrome vite build --watch",
    "build": "npm run build:firefox && npm run build:chrome",
    "prebuild:firefox": "npm run vocab",
    "build:firefox": "TARGET=firefox vite build",
    "prebuild:chrome": "npm run vocab",
    "build:chrome": "TARGET=chrome vite build",
    "icons": "for s in 16 32 48 128; do magick -background none -density 600 public/icons/icon.svg -resize ${s}x${s} public/icons/icon-$s.png; done",
    "pretest": "npm run vocab",
    "test": "tsx --test test/*.test.ts && tsx test/run.ts",
    "zip": "for t in firefox chrome; do (cd dist/$t && zip -qr ../../entity-viewer-$t.zip .); done"
  },
  "dependencies": {
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@tabler/icons-react": "^3.48.0",
    "cytoscape": "^3.34.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
