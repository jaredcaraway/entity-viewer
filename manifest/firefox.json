{
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "Entity Viewer",
    "default_panel": "sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Toggle the Entity Viewer sidebar"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "entity-viewer@jaredcaraway.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "action": {
    "default_icon": "icons/icon.svg"
  }
}
