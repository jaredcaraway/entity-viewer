{
  "manifest_version": 3,
  "name": "Entity Viewer",
  "version": "0.2.0",
  "description": "Visualize structured data (JSON-LD, Microdata, RDFa) on any page as an entity graph, with SEO-focused validation.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["scripting", "tabs", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Toggle Entity Viewer",
    "default_icon": "icons/icon.svg"
  },
  "sidebar_action": {
    "default_title": "Entity Viewer",
    "default_panel": "sidebar.html",
    "default_icon": "icons/icon.svg",
    "open_at_install": false
  },
  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Toggle the Entity Viewer sidebar"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "entity-viewer@jaredcaraway.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
